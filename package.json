{
  "name": "publixia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": true
    }
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch backend/server.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node backend/server.js",
    "seed": "node backend/seed/run.js",
    "import:research": "node scripts/import-research.js",
    "setup:criteria": "node scripts/seed-authority-context.js",
    "check:services": "node scripts/check-services.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "package": "node scripts/package.js",
    "setup:admin": "node scripts/setup-admin.js",
    "test:email": "node scripts/test-email.js",
    "db:indexes": "node scripts/db-indexes.js"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "docx": "^9.15.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "fflate": "^0.8.3",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vite": "^8.3.6"
  }
}
